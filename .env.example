# ------------------------------------------------------------
# Balap Ketik - environment variables
# Copy this file to ".env" (same folder) and adjust if needed.
# THIS PROJECT DOES NOT USE A DATABASE - no DB variables needed.
# ------------------------------------------------------------

# Port of the Node.js / Socket.IO server
PORT=3001

# URL of the React client (used for CORS in production).
# Multiple origins can be separated with commas.
CLIENT_URL=http://localhost:5173

# Optional: absolute path of the built client that the server should serve.
# Defaults to ./client/dist
# CLIENT_DIST=

# Optional (client): only needed when the client is deployed on a different
# domain than the server, e.g. client on Vercel + server on Render.
# Leave empty to connect to the same origin (recommended).
# VITE_SERVER_URL=https://your-balap-ketik-server.example.com
